# MongoDB connection (local example; use your Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/hr_foundation

# Public URL of the site (canonical links, sitemap, password-reset links)
# Use the exact address visitors end on (e.g. https://www.example.org if the bare domain redirects to www).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Set to "true" ONLY on the live production site. Any other value blocks search engines (safe for staging).
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional: the "content" value of Google Search Console's HTML-tag verification (not needed with DNS verification).
GOOGLE_SITE_VERIFICATION=

# Email via SMTP (preferred). For Gmail use an App password (Google Account → Security → App passwords).
EMAIL_USER=
EMAIL_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), EMAIL_FROM ("Name <address>")

# Email via Resend (https://resend.com). Server-side only — never prefix with NEXT_PUBLIC_.
# Without these, notifications are logged as "skipped" and password resets are done by a Super Admin.
RESEND_API_KEY=
FORM_FROM_EMAIL="H R Foundation <noreply@your-domain.example>"
# Optional fallback inbox for new-enquiry alerts (the dashboard's Website Settings take priority)
FORM_TO_EMAIL=

# Razorpay online payments (donations + membership fee). Online payment appears only when both keys are set.
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys first; switch to rzp_live_… after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://<your-domain>/api/payments/razorpay/webhook,
# events payment.captured + order.paid, and the same secret here.
RAZORPAY_WEBHOOK_SECRET=
