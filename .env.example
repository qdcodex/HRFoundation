# MongoDB connection (local example; use your Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/hr_foundation

# Public URL of the site (canonical links, sitemap, password-reset links)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Set to "true" ONLY on the live production site. Any other value blocks search engines (safe for staging).
NEXT_PUBLIC_ALLOW_INDEXING=false

# Email via Resend (https://resend.com). Server-side only — never prefix with NEXT_PUBLIC_.
# Without these, notifications are logged as "skipped" and password resets are done by a Super Admin.
RESEND_API_KEY=
FORM_FROM_EMAIL="H R Foundation <noreply@your-domain.example>"
# Optional fallback inbox for new-enquiry alerts (the dashboard's Website Settings take priority)
FORM_TO_EMAIL=
